<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A6000000" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/galleryPill"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_top_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/photo_group_pill"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/countBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_count_badge"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:minWidth="24dp"
                android:gravity="center"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/favoritesButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_dark"
            android:contentDescription="@string/home_favorites"
            android:padding="11dp"
            android:src="@drawable/ic_heart"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_dark"
            android:contentDescription="@string/settings"
            android:padding="11dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="80dp"
        android:paddingBottom="90dp">

        <LinearLayout
            android:id="@+id/photoContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/cardStack"
                android:layout_width="@dimen/photo_stack_width"
                android:layout_height="@dimen/photo_stack_height"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.kkorpse.less.ui.FanCardView
                    android:id="@+id/cardLeft"
                    android:layout_width="@dimen/photo_card_width"
                    android:layout_height="@dimen/photo_card_height"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:elevation="8dp"
                    android:focusable="true"
                    android:rotation="-9" />

                <com.kkorpse.less.ui.FanCardView
                    android:id="@+id/cardRight"
                    android:layout_width="@dimen/photo_card_width"
                    android:layout_height="@dimen/photo_card_height"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:elevation="8dp"
                    android:focusable="true"
                    android:rotation="9" />

                <com.kkorpse.less.ui.FanCardView
                    android:id="@+id/cardCenter"
                    android:layout_width="@dimen/photo_card_width"
                    android:layout_height="@dimen/photo_card_height"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:elevation="16dp"
                    android:focusable="true" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/emptyPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_photo_library"
                app:tint="@color/text_tertiary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/photo_empty_title"
                android:textColor="@color/text_primary"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="@string/photo_empty_message"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/emptyRefresh"
                style="@style/Widget.Less.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/refresh" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/text_secondary"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
