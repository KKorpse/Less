<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_scrim_top" />

    <LinearLayout
        android:id="@+id/videoActions"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="120dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/favoriteAction"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_dark"
            android:contentDescription="@string/favorite"
            android:padding="12dp"
            android:src="@drawable/ic_heart"
            app:tint="@color/accent" />

        <ImageButton
            android:id="@+id/deleteAction"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_circle_dark"
            android:contentDescription="@string/delete"
            android:padding="12dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/accent" />

        <ImageButton
            android:id="@+id/undoAction"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:alpha="0.4"
            android:background="@drawable/bg_circle_dark"
            android:contentDescription="@string/undo_content_desc"
            android:padding="12dp"
            android:src="@drawable/ic_undo"
            app:tint="@color/accent" />
    </LinearLayout>

    <TextView
        android:id="@+id/videoTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="88dp"
        android:background="@drawable/bg_top_pill"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:textColor="@color/accent"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/videoProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="74dp"
        android:max="1000"
        android:progress="0"
        android:progressBackgroundTint="#22FFFFFF"
        android:progressTint="@color/accent_blue" />

    <ImageView
        android:id="@+id/playIndicator"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_circle_dark"
        android:contentDescription="@null"
        android:padding="20dp"
        android:src="@drawable/ic_play"
        app:tint="@color/accent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/emptyPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_video"
            app:tint="@color/text_tertiary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="@string/video_empty_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="@string/video_empty_message"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/emptyUndo"
            style="@style/Widget.Less.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/undo"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/text_secondary"
        android:visibility="gone" />
</FrameLayout>
